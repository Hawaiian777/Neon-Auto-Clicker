<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Neon" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/black</item>
        <item name="android:colorPrimaryDark">@color/black</item>
        <item name="android:colorAccent">@color/neon</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/neon</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.Neon.Dialog</item>
    </style>

    <style name="Theme.Neon.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/neon</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/neon</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorAlertDialogListItem">@color/neon</item>
    </style>

    <style name="NeonTitle">
        <item name="android:textColor">@color/neon</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:shadowColor">@color/neon</item>
        <item name="android:shadowRadius">18</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
    </style>

    <style name="NeonCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="NeonCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/neon</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="NeonBody">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="NeonOutlineButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_outline</item>
        <item name="android:textColor">@color/neon</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NeonFilledButton" parent="NeonOutlineButton">
        <item name="android:background">@drawable/bg_filled</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">60dp</item>
    </style>

    <style name="NeonChip" parent="NeonOutlineButton">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>
